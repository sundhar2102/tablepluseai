PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tablepulse_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_long_replace_this
JWT_EXPIRY=24h

# CORS — Frontend origin
CLIENT_URL=http://localhost:5173

# Application defaults
DEFAULT_SEARCH_RADIUS_KM=5
DEFAULT_TAX_RATE=5.00
DEFAULT_AVG_DINING_MINS=45
DEFAULT_AVG_CLEANING_MINS=10
QUEUE_TIMEOUT_MINS=10
RESERVATION_NO_SHOW_MINS=15

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# OpenStreetMap / Overpass API Configuration
OVERPASS_API_URL=https://overpass.openstreetmap.fr/api/interpreter

# OpenAI API Configuration (TablePulse AI Assistant & Recommendations)
OPENAI_API_KEY=your_openai_api_key_here

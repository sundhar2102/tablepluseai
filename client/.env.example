VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:3001

# For Real Physical Phone testing on local Wi-Fi:
# Set VITE_API_HOST to your development PC's Wi-Fi IPv4 address (e.g. 192.168.137.202 or run 'ipconfig')
VITE_API_HOST=192.168.137.202

# Optional: If VITE_API_HOST is unset, Android defaults automatically to http://10.0.2.2:3001 for emulator
# Explicit mobile overrides:
# VITE_MOBILE_API_URL=http://<YOUR_LAN_IP>:3001/api
# VITE_MOBILE_SOCKET_URL=http://<YOUR_LAN_IP>:3001

